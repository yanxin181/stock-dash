{
  "name": "stock-chat-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n frontend,backend \"npm:dev\" \"npm:dev:server\"",
    "build": "vue-tsc --noEmit && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start:server": "node dist-server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "echarts": "^5.6.0",
    "express": "^5.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
