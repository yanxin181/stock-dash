{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["server/**/*.ts", "src/services/validateSchema.ts", "src/types/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
